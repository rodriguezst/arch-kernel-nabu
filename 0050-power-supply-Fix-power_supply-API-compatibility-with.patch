From 9f870f3c2d1846c11d99d242ec7ac6e870cad67b Mon Sep 17 00:00:00 2001
From: "github-actions[bot]" <github-actions[bot]@users.noreply.github.com>
Date: Mon, 29 Sep 2025 23:17:57 +0000
Subject: [PATCH 50/50] power: supply: Fix power_supply API compatibility with
 kernel 6.17
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adapt to power_supply API changes in kernel 6.17:
- Replace power_supply_config.of_node with .fwnode using dev_fwnode()
- Replace power_supply_get_by_phandle() with power_supply_get_by_reference()
- Add static keywords to IRQ handlers to fix -Wmissing-prototypes

🤖 Generated with [Claude Code](https://claude.com/claude-code)

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/power/supply/ln8000_charger.c |  4 ++--
 drivers/power/supply/qcom_fg.c        | 10 +++++-----
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/drivers/power/supply/ln8000_charger.c b/drivers/power/supply/ln8000_charger.c
index da3d78187a80..73808ae5b79d 100644
--- a/drivers/power/supply/ln8000_charger.c
+++ b/drivers/power/supply/ln8000_charger.c
@@ -1492,7 +1492,7 @@ static int ln8000_parse_dt(struct ln8000_info *info)
 static int ln8000_psy_register(struct ln8000_info *info)
 {
     info->psy_cfg.drv_data = info;
-    info->psy_cfg.of_node  = info->client->dev.of_node;
+    info->psy_cfg.fwnode   = dev_fwnode(&info->client->dev);
     info->psy_desc.name 		= "ln8000-charger";
     info->psy_desc.type 		= POWER_SUPPLY_TYPE_MAINS;
     info->psy_desc.properties	= ln8000_charger_props;
@@ -1569,7 +1569,7 @@ static int ln8000_probe(struct i2c_client *client)
     info->dev = &client->dev;
     info->client = client;
 
-    info->typec_psy = power_supply_get_by_phandle(info->dev->of_node,"usb-tcpm");
+    info->typec_psy = power_supply_get_by_reference(dev_fwnode(info->dev), "usb-tcpm");
 
     if(info->typec_psy == NULL){
 	ret = -(EPROBE_DEFER);
diff --git a/drivers/power/supply/qcom_fg.c b/drivers/power/supply/qcom_fg.c
index 2d6ad9f9718d..d1601c3c482e 100644
--- a/drivers/power/supply/qcom_fg.c
+++ b/drivers/power/supply/qcom_fg.c
@@ -1063,7 +1063,7 @@ static int qcom_fg_clear_ima(struct qcom_fg_chip *chip,
 	return 0;
 }
 
-irqreturn_t qcom_fg_handle_soc_delta(int irq, void *data)
+static irqreturn_t qcom_fg_handle_soc_delta(int irq, void *data)
 {
 	struct qcom_fg_chip *chip = data;
 
@@ -1074,7 +1074,7 @@ irqreturn_t qcom_fg_handle_soc_delta(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
-irqreturn_t qcom_fg_handle_mem_avail(int irq, void *data)
+static irqreturn_t qcom_fg_handle_mem_avail(int irq, void *data)
 {
 	struct qcom_fg_chip *chip = data;
 
@@ -1201,7 +1201,7 @@ static int qcom_fg_probe(struct platform_device *pdev)
 	}
 
 	supply_config.drv_data = chip;
-	supply_config.of_node = pdev->dev.of_node;
+	supply_config.fwnode = dev_fwnode(&pdev->dev);
 
 	chip->batt_psy = devm_power_supply_register(chip->dev,
 			&batt_psy_desc, &supply_config);
@@ -1304,8 +1304,8 @@ static int qcom_fg_probe(struct platform_device *pdev)
 	}
 
 	/* Optional: Get charger power supply for status checking */
-	chip->chg_psy = power_supply_get_by_phandle(chip->dev->of_node,
-							"power-supplies");
+	chip->chg_psy = power_supply_get_by_reference(dev_fwnode(chip->dev),
+						       "power-supplies");
 	if (IS_ERR(chip->chg_psy)) {
 		ret = PTR_ERR(chip->chg_psy);
 		dev_warn(chip->dev, "Failed to get charger supply: %d\n", ret);
-- 
