From b60288eb6d646b1e017af6d72be923d4824ff193 Mon Sep 17 00:00:00 2001
From: rodriguezst <2828844+rodriguezst@users.noreply.github.com>
Date: Thu, 16 Oct 2025 13:08:49 +0000
Subject: [PATCH] Add stabilization time for DSI PHY PLLs on SM8150

---
 drivers/clk/qcom/dispcc-sm8250.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/clk/qcom/dispcc-sm8250.c b/drivers/clk/qcom/dispcc-sm8250.c
index 8f433e1e7..461e567d2 100644
--- a/drivers/clk/qcom/dispcc-sm8250.c
+++ b/drivers/clk/qcom/dispcc-sm8250.c
@@ -1271,6 +1271,14 @@ static int disp_cc_sm8250_probe(struct platform_device *pdev)
 		return PTR_ERR(regmap);
 	}
 
+	/* SM8150 Xiaomi Pad 5: DSI PHY PLLs need stabilization time.
+	 * The 7nm DSI PHYs used on SM8150 require 5-10ms after PLL lock
+	 * before their output clocks are stable for use as parent clocks.
+	 */
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sm8150-dispcc")) {
+		usleep_range(5000, 10000);
+	}
+
 	/* Apply differences for SM8150 and SM8350 */
 	BUILD_BUG_ON(CLK_ALPHA_PLL_TYPE_TRION != CLK_ALPHA_PLL_TYPE_LUCID);
 	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sc8180x-dispcc") ||
-- 
2.50.1

